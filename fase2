# pacotes
paru -S limine-mkinitcpio-hook limine-snapper-sync
sudo pacman -S snapper snap-pac

# configurando o snapper
sudo umount /.snapshots 2>/dev/null
sudo rm -rf /.snapshots
sudo snapper -c root create-config /
sudo systemctl enable snapper-cleanup.timer
sudo sed -i \
	-e 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="no"/' \
	-e 's/^NUMBER_LIMIT=.*/NUMBER_LIMIT="5"/' \
	-e 's/^NUMBER_LIMIT_IMPORTANT=.*/NUMBER_LIMIT_IMPORTANT="5"/' \
	/etc/snapper/configs/root
sudo btrfs subvolume delete /.snapshots
sudo mkdir /.snapshots
sudo mount -a
sudo chmod 750 /.snapshots
sudo cp etc/default/limine /etc/default/limine
set ROOT_UUID (findmnt -no UUID /)
sudo sed -i "s|<UUID-DO-BTRFS>|$ROOT_UUID|" /etc/default/limine
sudo cp etc/limine-snapper-sync.conf /etc/limine-snapper-sync.conf
sudo mkdir -p /etc/mkinitcpio.conf.d
sudo cp etc/mkinitcpio.conf.d/10-btrfs-overlayfs.conf /etc/mkinitcpio.conf.d/
sudo mkinitcpio -P

# snapshots
sudo systemctl enable --now limine-snapper-sync.service
sudo limine-snapper-sync

# pre-kerne(se precisar)
sudo pacman -S pacman-contrib
cd ~/.cache/paru/clone/linux-cachyos-bore
updpkgsums
paru -Ui

# kernel cachyos
paru -S linux-cachyos-bore
