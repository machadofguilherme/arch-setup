# Subvolume para snapshot
SUBVOLUME="/"

# Sistema de arquivos
FSTYPE="btrfs"

# Snapshots automáticos por intervalo
TIMELINE_CREATE="yes"

# Limpeza automática
TIMELINE_CLEANUP="yes"
NUMBER_CLEANUP="yes"

# Limites de snapshots por atualização
NUMBER_LIMIT="5"
NUMBER_LIMIT_IMPORTANT="5"

# Limites da linha do tempo
TIMELINE_LIMIT_HOURLY="5"
TIMELINE_LIMIT_DAILY="7"
TIMELINE_LIMIT_WEEKLY="0"
TIMELINE_LIMIT_MONTHLY="3"
TIMELINE_LIMIT_YEARLY="0"

# Idade mínima para limpeza
TIMELINE_MIN_AGE="1800"
